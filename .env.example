# Gmail SMTP credentials for sending the dinner invitation email to your gmail account
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional fallback: Resend API Key
RESEND_API_KEY=

# /admin storage: Upstash Redis REST credentials (Vercel's Upstash integration
# may name these KV_REST_API_URL / KV_REST_API_TOKEN, which also work).
# Without them, local dev saves to .data/restaurants.json and production is read-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# /admin auto-fill from Google Maps links: a SerpApi key (free plan, ~250 searches/month;
# each added restaurant uses 2–4). Get it at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
